# syntax=docker/dockerfile:1
# RVC-WebUI-MacOS — Apple Silicon (arm64) 向け Dockerfile

FROM python:3.10-slim-bookworm

EXPOSE 7860

WORKDIR /app

# システム依存パッケージ
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        gcc g++ \
        aria2 \
        ffmpeg \
        git \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# pip アップグレード
RUN pip install --upgrade pip

# requirements を先にコピーし、Docker(Linux)で問題になる行を除外
COPY requirements/main.txt /tmp/requirements-orig.txt
RUN sed '/onnxruntime-gpu/d; /onnxruntime;/d; /fairseq/d; s/numpy==1.23.5/numpy/' /tmp/requirements-orig.txt > /tmp/requirements.txt

# PyTorch (CPU) — Docker on Apple Silicon は MPS 非対応なので CPU 版
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# fairseq の omegaconf 問題を回避: pip<24.1 で一時インストール
RUN pip install "pip==23.3.2" && \
    pip install --no-cache-dir fairseq && \
    pip install --upgrade pip

# 残りの依存パッケージ + onnxruntime(CPU版)を明示追加
RUN pip install --no-cache-dir -r /tmp/requirements.txt onnxruntime

# アプリケーションコードをコピー
COPY . .

# pretrained モデルのダウンロード
RUN aria2c --console-log-level=error -c -x 16 -s 16 -k 1M \
    https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/pretrained_v2/D40k.pth \
    -d assets/pretrained_v2/ -o D40k.pth && \
    aria2c --console-log-level=error -c -x 16 -s 16 -k 1M \
    https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/pretrained_v2/G40k.pth \
    -d assets/pretrained_v2/ -o G40k.pth && \
    aria2c --console-log-level=error -c -x 16 -s 16 -k 1M \
    https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/pretrained_v2/f0D40k.pth \
    -d assets/pretrained_v2/ -o f0D40k.pth && \
    aria2c --console-log-level=error -c -x 16 -s 16 -k 1M \
    https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/pretrained_v2/f0G40k.pth \
    -d assets/pretrained_v2/ -o f0G40k.pth

# UVR5 モデル
RUN aria2c --console-log-level=error -c -x 16 -s 16 -k 1M \
    "https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/uvr5_weights/HP2-%E4%BA%BA%E5%A3%B0vocals%2B%E9%9D%9E%E4%BA%BA%E5%A3%B0instrumentals.pth" \
    -d assets/uvr5_weights/ -o "HP2-人声vocals+非人声instrumentals.pth" && \
    aria2c --console-log-level=error -c -x 16 -s 16 -k 1M \
    "https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/uvr5_weights/HP5-%E4%B8%BB%E6%97%8B%E5%BE%8B%E4%BA%BA%E5%A3%B0vocals%2B%E5%85%B6%E4%BB%96instrumentals.pth" \
    -d assets/uvr5_weights/ -o "HP5-主旋律人声vocals+其他instrumentals.pth"

# Hubert & RMVPE
RUN aria2c --console-log-level=error -c -x 16 -s 16 -k 1M \
    https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/hubert_base.pt \
    -d assets/hubert -o hubert_base.pt && \
    aria2c --console-log-level=error -c -x 16 -s 16 -k 1M \
    https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/rmvpe.pt \
    -d assets/rmvpe -o rmvpe.pt

VOLUME ["/app/assets/weights", "/app/opt"]

CMD ["python", "web.py", "--port", "7860"]
