<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox off for Phase 1–10: we run an embedded Python interpreter
         and spawn child processes. Add sandboxing in a later hardening pass. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- Allow PyTorch's JIT / MPS code generation. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Many torch / fairseq .so files are not codesigned by upstream; allow
         them to load after we codesign them ourselves at bundle time. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Unsigned executable memory is used by PyTorch and some numeric libs. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Microphone access for realtime VC. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
